{
  "name": "concerto-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "perf:parse": "vitest run -c vitest.perf.config.ts",
    "perf:e2e": "playwright test -c playwright.perf.config.ts",
    "perf_test": "npm run perf:parse && npm run perf:e2e"
  },
  "dependencies": {
    "@accordproject/concertino": "^4.1.3",
    "@accordproject/concerto-codegen": "^4.1.0",
    "@accordproject/concerto-core": "^4.1.0",
    "@accordproject/concerto-cto": "^4.1.0",
    "@accordproject/concerto-util": "^4.1.0",
    "@monaco-editor/react": "^4.6.0",
    "@xyflow/react": "^12.10.2",
    "elkjs": "^0.11.1",
    "fuse.js": "^7.4.2",
    "jszip": "^3.10.1",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/lz-string": "^1.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.0.16",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.6"
  }
}
